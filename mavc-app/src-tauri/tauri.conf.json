{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "malbum",
  "version": "0.1.0",
  "identifier": "org.mavc.app",
  "build": {
    "beforeDevCommand": "dx serve --port 1420 --interactive false",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "dx bundle --release",
    "frontendDist": "../dist/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "malbum",
        "width": 1280,
        "height": 900,
        "minWidth": 940,
        "minHeight": 720,
        "backgroundColor": "#101018"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "AzathoX (Zheng Zeref SW)",
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mavc"
        ],
        "name": "MAVC music archive",
        "description": "malbum music archive",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-mavc",
        "exportedType": {
          "identifier": "org.mavc.archive",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ]
  }
}
